# Supabase (configured via Supabase MCP)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API (required for live AI code generation & rubric scoring)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Judge0 CE (Primary isolated code execution engine)
# Supports RapidAPI (https://judge0-ce.p.rapidapi.com) or self-hosted (http://localhost:2358)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Fallback local execution for demo when Judge0 CE is not yet configured (true | false)
ALLOW_LOCAL_EXECUTOR_FALLBACK=true
